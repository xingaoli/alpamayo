    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: debug_ar1_test",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/ar1_test.py",
            "args": [
            ],
            "env": {
                "CUDA_VISIBLE_DEVICES": "0",      // 指定GPU
                "TORCH_DISTRIBUTED_DEBUG": "DETAIL"
            },
            "justMyCode": false
        },
        {
            "name": "Python: debug_data_pipeline",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/debug_data_pipeline.py",
            "args": [],
            "console": "integratedTerminal",
            "env": {
                "CUDA_VISIBLE_DEVICES": "0"
            },
            "justMyCode": false
        },
        {
            "name": "Python: eval_checkpoint",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/eval_checkpoint.py",
            "args": [],
            "console": "integratedTerminal",
            "env": {
                "CUDA_VISIBLE_DEVICES": "0"
            },
            "justMyCode": false
        },
        {
            "name": "SFT Stage1: torchrun 2GPU",
            "type": "debugpy",
            "request": "launch",
            "module": "torch.distributed.run",
            "cwd": "${workspaceFolder}",
            "args": [
                "--nproc_per_node=2",
                "finetune/sft/train_hf.py",
                "--config-path=${workspaceFolder}/finetune/sft/configs",
                "--config-name=sft_stage1_local"
            ],
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "CUDA_VISIBLE_DEVICES": "0,1",
                "TORCH_DISTRIBUTED_DEBUG": "DETAIL",
                "HYDRA_FULL_ERROR": "1",
                "NCCL_DEBUG": "INFO"
            },
            "justMyCode": false
        },
    ]
}