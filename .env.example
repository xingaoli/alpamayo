# Alpamayo 环境变量配置示例
# 复制此文件为 .env 并填写实际路径

# Qwen3-VL 处理器模型路径
QWEN3_VL_PROCESSOR="ckpts/Qwen3-VL-8B-Instruct-config"

# VLM 模型默认路径
VLM_MODEL_PATH="ckpts/Qwen3-VL-8B-Instruct-config"

# Alpamayo-R1 模型路径
ALPAMAYO_R1_MODEL="ckpts/Alpamayo-R1-10B"

# 数据集目录
DATA_DIR="data/PhysicalAI-Autonomous-Vehicles"
