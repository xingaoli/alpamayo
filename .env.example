# Alpamayo 环境变量配置示例
# 复制此文件为 .env 并填写实际路径

# 模型检查点路径
ALPAMAYO_MODEL_CKPT=/path/to/Alpamayo-1.5-10B
ALPAMAYO_VLM_PROCESSOR_CKPT=/path/to/Qwen3-VL-8B-Instruct-config

# 数据集路径
ALPAMAYO_DATA_DIR=/path/to/PhysicalAI-Autonomous-Vehicles

# 摄像头配置: 4cam (默认) 或 2cam (front_wide + front_tele)
ALPAMAYO_CAMERA_MODE=4cam

# COC 训练数据 (coc_combined_merged.jsonl 路径)
ALPAMAYO_COC_JSONL=/path/to/coc_combined_merged.jsonl
